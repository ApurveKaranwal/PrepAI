# =============================================================================
# PrepFlow backend configuration
# Copy to .env and fill in. Never commit .env — it holds live credentials, and
# candidate-submitted code runs on this server (see code_studio/sandbox.py).
# =============================================================================

# --- Database ---------------------------------------------------------------
# Neon PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- LLM providers ----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --- Speech-to-text & text-to-speech ---------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- GitHub ----------------------------------------------------------------
# Optional but strongly recommended in production. Candidate DevScores are
# computed from live GitHub data; unauthenticated calls are capped at 60/hour per
# IP, which is not enough to serve a recruiter search page.
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Web security -----------------------------------------------------------
# Comma-separated list of exact browser origins allowed to call this API.
# Credentials are sent with these requests, so this must never be a wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://prepai.apurve.xyz

# Absolute public base URL of the frontend. Used to build take-home invite links
# in outbound email, so it must be reachable by the candidate — not localhost in
# production.
PUBLIC_APP_URL=https://prepai.apurve.xyz

# --- Untrusted code execution ----------------------------------------------
# How candidate-submitted code is run. See the docstring at the top of
# backend/code_studio/sandbox.py before changing this.
#
#   docker    Required in production. One throwaway container per run: no
#             network, read-only root filesystem, all capabilities dropped,
#             non-root uid, capped memory/CPU/pids. The host filesystem is not
#             visible, so this .env file is unreachable by construction.
#   hardened  Local development only. Secrets are scrubbed from the child
#             environment and the working directory is a throwaway temp dir, but
#             the filesystem is NOT confined: candidate code runs as this OS
#             user and can still open any file that user can read.
SANDBOX_MODE=hardened

# Container images used when SANDBOX_MODE=docker. Pin to digests in production.
SANDBOX_IMAGE_PYTHON=python:3.11-alpine
SANDBOX_IMAGE_NODE=node:20-alpine
SANDBOX_IMAGE_CPP=gcc:13

# --- Take-home assessments --------------------------------------------------
# Days a dispatched take-home invite stays valid before the link returns 410.
TAKEHOME_TTL_DAYS=7

# --- Outbound email (optional) ---------------------------------------------
# Unset, the platform degrades gracefully: it records a receipt instead of
# sending, and nothing fails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM=PrepFlow <no-reply@yourdomain.com>
